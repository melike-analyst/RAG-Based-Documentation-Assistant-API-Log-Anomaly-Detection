# Bu dosyayı .env olarak kopyalayıp kendi anahtarınızı girin. .env asla Git'e commit edilmemelidir.

# Kullanılacak LLM sağlayıcısı: "anthropic" veya "openai" (boş bırakılırsa RAG sadece retrieval modunda çalışır)
RAG_LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=your-anthropic-key-here
OPENAI_API_KEY=your-openai-key-here
